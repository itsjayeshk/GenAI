#include <stdio.h>
#include <conio.h>
#define MAX 50   
struct Employee {
    int id;
    char name[30];
    char designation[30];
    float monthlysalary;
};


float AnnualSalary(float monthlysalary) {
    return monthlysalary * 12;
}

void main() {
    struct Employee emp[MAX];
    int n, i;
    float amount, annualSalary;

    clrscr();

    printf("Enter number of employees (max %d): ", MAX);
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("\nEnter details of employee %d\n", i + 1);

        printf("ID: ");
        scanf("%d", &emp[i].id);

        printf("Name: ");
        scanf("%s", emp[i].name);

        printf("Designation: ");
        scanf("%s", emp[i].designation);

        printf("Monthly Salary: ");
        scanf("%f", &emp[i].monthlysalary);
    }

    printf("\nEnter annual salary amount to filter employees: ");
    scanf("%f", &amount);

    printf("\nEmployees earning above %.2f annually:\n", amount);

    for (i = 0; i < n; i++) {
	annualSalary = AnnualSalary(emp[i].monthlysalary);

        if (annualSalary > amount) {
            printf("\nID: %d", emp[i].id);
            printf("\nName: %s", emp[i].name);
            printf("\nDesignation: %s", emp[i].designation);
            printf("\nAnnual Salary: %.2f\n", annualSalary);
        }
    }

    getch();
}
